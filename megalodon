#!/usr/bin/env bash
# megalodon - one command for the Linux Megalodon OPSEC switches.
set -uo pipefail

G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; D=$'\033[0;37m'; N=$'\033[0m'
root() { if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi; }

usage() {
cat <<EOF
${G}LINUX MEGALODON${N}  ::  FLIPPER X family
  megalodon status            radios, firewall, USB lock, DNS, camera
  megalodon radios off|on     kill / restore Wi-Fi + Bluetooth (rfkill)
  megalodon bt on|off         Bluetooth service (off by default)
  megalodon cam on|off        webcam driver (off by default)
  megalodon dns strict|portal strict = Quad9 over TLS only (default)
                              portal = use the network's DNS, for hotel/cafe sign-in pages
  megalodon usb               list USB devices and whether they are allowed
  megalodon usb allow <id>    permanently allow one device (number from 'megalodon usb')
  megalodon flipper           show connected Flipper-family devices
  megalodon ghost on|off      Tails-style: ALL traffic through Tor or dropped (fail-closed)
  megalodon ghost check       ask the Tor Project whether you are really on Tor
  megalodon killcord arm      pick a USB device; pulling it out powers the laptop off instantly
  megalodon killcord disarm   remove the kill-cord
  megalodon panic             power off NOW (no password; also Ctrl+Alt+Backspace)
  megalodon unbrand           restore the stock Kali boot splash, GRUB theme and login screen

  Log in as 'ghost' for a Tails session: RAM-only home, Tor-only network, wiped at logout.
EOF
}

status() {
  echo "${G}LINUX MEGALODON${N} :: $(hostname)"
  echo "  disk      $( [[ $'\n'"$(lsblk -no TYPE)"$'\n' == *$'\n'crypt$'\n'* ]] && echo "${G}encrypted${N}" || echo "${R}NOT encrypted${N}")"
  echo "  firewall  $(sudo ufw status 2>/dev/null | head -1 | sed 's/Status: //')"
  echo "  usb lock  $(systemctl is-active usbguard 2>/dev/null)"
  if [[ -f /etc/NetworkManager/conf.d/91-megalodon-dns.conf ]]; then
    echo "  dns       ${G}strict${N} (Quad9 over TLS)"
  else
    echo "  dns       ${Y}portal${N} (network DNS - switch back: megalodon dns strict)"
  fi
  echo "  camera    $( [[ -f /etc/modprobe.d/megalodon-cam.conf ]] && echo "${G}off${N}" || echo "${Y}on${N}")"
  echo "  bluetooth $(systemctl is-active bluetooth 2>/dev/null)"
  if [[ -f /etc/systemd/resolved.conf.d/zz-megalodon-ghost.conf ]]; then
    echo "  ghost     ${G}ON${N} (Tor-only, fail-closed)"
  else
    echo "  ghost     off"
  fi
  if [[ -f /etc/udev/rules.d/99-megalodon-killcord.rules ]]; then
    echo "  killcord  ${G}ARMED${N} ($(sed -n 's/^# cord: //p' /etc/udev/rules.d/99-megalodon-killcord.rules))"
  else
    echo "  killcord  disarmed"
  fi
  echo "  swap      $(swapon --show=NAME --noheadings 2>/dev/null | tr '\n' ' ')"
  echo "  radios:"; rfkill list 2>/dev/null | sed 's/^/    /'
}

case "${1:-}" in
  status|"") status ;;
  radios)
    root "$@"
    case "${2:-}" in
      off) rfkill block all; echo "${G}all radios blocked${N}" ;;
      on)  rfkill unblock all; echo "${Y}radios unblocked${N}" ;;
      *) usage; exit 2 ;;
    esac ;;
  bt)
    root "$@"
    case "${2:-}" in
      on)  rfkill unblock bluetooth; systemctl start bluetooth; echo "${Y}Bluetooth ON${N} - turn it off when done: megalodon bt off" ;;
      off) systemctl stop bluetooth; rfkill block bluetooth; echo "${G}Bluetooth OFF${N}" ;;
      *) usage; exit 2 ;;
    esac ;;
  cam)
    root "$@"
    case "${2:-}" in
      on)  rm -f /etc/modprobe.d/megalodon-cam.conf; modprobe uvcvideo && echo "${Y}camera ON${N}" ;;
      off) echo "blacklist uvcvideo" > /etc/modprobe.d/megalodon-cam.conf; modprobe -r uvcvideo 2>/dev/null; echo "${G}camera OFF${N} (if it is in use, close the app and run this again)" ;;
      *) usage; exit 2 ;;
    esac ;;
  dns)
    root "$@"
    case "${2:-}" in
      strict)
        printf '[main]\ndns=none\n' > /etc/NetworkManager/conf.d/91-megalodon-dns.conf
        rm -f /etc/systemd/resolved.conf.d/99-megalodon-portal.conf
        systemctl restart systemd-resolved NetworkManager
        echo "${G}DNS strict${N}: Quad9 over TLS only" ;;
      portal)
        rm -f /etc/NetworkManager/conf.d/91-megalodon-dns.conf
        printf '[Resolve]\nDNSOverTLS=opportunistic\n' > /etc/systemd/resolved.conf.d/99-megalodon-portal.conf
        systemctl restart systemd-resolved NetworkManager
        echo "${Y}DNS portal mode${N}: sign in to the Wi-Fi page, then run: megalodon dns strict" ;;
      *) usage; exit 2 ;;
    esac ;;
  usb)
    case "${2:-}" in
      "") sudo usbguard list-devices | sed -E "s/^([0-9]+): (allow)/${G}\1: \2${N}/; s/^([0-9]+): (block|reject)/${R}\1: \2${N}/" ;;
      allow)
        [[ -n "${3:-}" ]] || { echo "usage: megalodon usb allow <number from 'megalodon usb'>"; exit 2; }
        sudo usbguard allow-device -p "$3" && echo "${G}device $3 allowed permanently${N}" ;;
      *) usage; exit 2 ;;
    esac ;;
  flipper)
    echo "${G}Flipper family on USB:${N}"
    lsusb | grep -Ei '0483:(5740|5741|df11)|303a:|0e8d:|18d1:4ee0' || echo "  ${D}nothing connected${N}"
    ls -l /dev/serial/by-id/ 2>/dev/null | grep -i flipper | sed 's/^/  /' || true
    command -v adb >/dev/null && adb devices -l | sed '1d;/^$/d;s/^/  adb: /' ;;
  ghost)
    case "${2:-}" in
      on)
        root "$@"
        # firewall first, so nothing can slip out while Tor starts (fail-closed)
        nft -f /etc/megalodon/ghost.nft || { echo "${R}could not load the Tor-only firewall - NOT in ghost mode${N}"; exit 1; }
        systemctl stop bluetooth 2>/dev/null; rfkill block bluetooth 2>/dev/null
        mkdir -p /etc/systemd/resolved.conf.d
        printf '[Resolve]\nDNS=\nDNS=127.0.0.1:5353\nDNSOverTLS=no\nDNSSEC=no\nDomains=~.\n' > /etc/systemd/resolved.conf.d/zz-megalodon-ghost.conf
        systemctl start tor
        systemctl restart systemd-resolved
        command -v conntrack >/dev/null && conntrack -F >/dev/null 2>&1
        echo "${G}GHOST MODE ON${N}: every packet goes through Tor or is dropped. Check it: megalodon ghost check" ;;
      off)
        root "$@"
        nft delete table inet megalodon_ghost 2>/dev/null
        rm -f /etc/systemd/resolved.conf.d/zz-megalodon-ghost.conf
        systemctl restart systemd-resolved
        systemctl stop tor
        echo "${Y}ghost mode off${N}: back to VPN/normal routing" ;;
      check)
        out="$(curl -s --max-time 30 https://check.torproject.org/api/ip)"
        if [[ "$out" == *'"IsTor":true'* ]]; then echo "${G}on Tor${N}  $out"; else echo "${R}NOT on Tor${N}  ${out:-no answer (Tor still bootstrapping, or blocked)}"; fi ;;
      *) usage; exit 2 ;;
    esac ;;
  killcord)
    root "$@"
    RULE=/etc/udev/rules.d/99-megalodon-killcord.rules
    case "${2:-}" in
      arm)
        before="$(ls /sys/bus/usb/devices/ | grep -v ':' | sort)"
        echo "Plug in the device you want as your kill-cord now (30 s)..."
        new=""
        for _ in $(seq 30); do
          sleep 1
          now="$(ls /sys/bus/usb/devices/ | grep -v ':' | sort)"
          new="$(comm -13 <(echo "$before") <(echo "$now") | head -1)"
          [[ -n "$new" ]] && break
        done
        [[ -n "$new" ]] || { echo "${R}no new USB device seen - nothing armed${N}"; exit 1; }
        d="/sys/bus/usb/devices/$new"
        vid="$(cat "$d/idVendor")"; pid="$(cat "$d/idProduct")"
        name="$(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null) [$vid:$pid]"
        prod="$(printf '%x/%x/' "0x$vid" "0x$pid")"
        {
          echo "# cord: $name"
          echo "ACTION==\"remove\", SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_device\", ENV{PRODUCT}==\"${prod}*\", RUN+=\"/usr/local/bin/megalodon panic\""
        } > "$RULE"
        udevadm control --reload
        echo "${G}KILL-CORD ARMED${N}: $name"
        echo "Pulling it out powers the laptop off at once, and the disk locks behind LUKS." ;;
      disarm) rm -f "$RULE"; udevadm control --reload; echo "kill-cord disarmed" ;;
      *) usage; exit 2 ;;
    esac ;;
  panic)
    root "$@"
    sync
    systemctl poweroff --force ;;
  unbrand)
    root "$@"
    prev="$(cat /etc/megalodon/plymouth.prev 2>/dev/null)"
    if [[ -n "$prev" ]]; then plymouth-set-default-theme -R "$prev"; fi
    rm -f /etc/default/grub.d/zz-megalodon.cfg && update-grub
    if [[ -f /etc/megalodon/lightdm-gtk-greeter.conf.orig ]]; then
      cp /etc/megalodon/lightdm-gtk-greeter.conf.orig /etc/lightdm/lightdm-gtk-greeter.conf
    fi
    echo "branding removed (hardening untouched)" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
